{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Executar Streamlit",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/streamlit",
            "args": [
                "run",
                "app.py"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}